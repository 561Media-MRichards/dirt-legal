{% comment %}
  UTV Hero Section
  Section: sections/utv-hero.liquid
{% endcomment %}

<section class="utv-hero">
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <h1>{{ section.settings.hero_title | default: 'Get Your UTV Street Legal in Any State' }}</h1>
        <p>{{ section.settings.hero_subtitle | default: 'Start with a quick 2-minute form. Processed in as little as 3 days. No DMV visits. No headaches. Just results.' }}</p>
        <a href="{{ section.settings.cta_link | default: '#utv-product' }}" class="cta-button">
          {{ section.settings.cta_text | default: 'Get My Registration' }}
        </a>
      </div>
      <div class="hero-image">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image | img_url: '600x300' }}" alt="{{ section.settings.hero_image.alt | default: 'UTV Street Legal' }}">
        {% else %}
          <div class="wireframe-box">
            <div class="wireframe-label">Hero Image/Video</div>
            UTV on Road with License Plate<br>
            (Video/Image Placeholder)
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UTV Hero",
  "tag": "section",
  "class": "utv-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Get Your UTV Street Legal in Any State"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Start with a quick 2-minute form. Processed in as little as 3 days. No DMV visits. No headaches. Just results."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Get My Registration"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link",
      "default": "#utv-product"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "UTV Hero"
    }
  ]
}
{% endschema %}